<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="hViewModel"
            type="com.jkweyu.quickqr.viewmodel.home.HomeRVItemViewModel" />
        <variable
            name="mViewModel"
            type="com.jkweyu.quickqr.viewmodel.MainViewModel" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">



        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:paddingHorizontal="@dimen/dp_08"
            android:paddingTop="@dimen/dp_08"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/base_color"
                android:backgroundTint="@color/base_color">
                <androidx.appcompat.widget.Toolbar
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@color/base_color"
                    android:padding="@dimen/dp_06"
                    app:layout_scrollFlags="scroll|enterAlwaysCollapsed">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:src="@drawable/ic_app_title" />
                    <TextView
                        android:id="@+id/status_dpi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="default"/>
                </androidx.appcompat.widget.Toolbar>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/base_color"
                    app:layout_scrollFlags="scroll|enterAlwaysCollapsed">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/qr_create_area"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_margin="@dimen/dp_06"

                        android:elevation="4dp"

                        android:background="@drawable/shape_qr_generation_button"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/qr_scan_area"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">


                        <FrameLayout
                            android:id="@+id/imageView01"
                            android:layout_width="0dp"
                            android:layout_height="0dp"

                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" >

                            <ImageView
                                android:layout_width="@dimen/dp_56"
                                android:layout_height="@dimen/dp_56"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_qr_generation_button_icon"/>
                        </FrameLayout>


                        <TextView
                            android:id="@+id/textView18"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginHorizontal="@dimen/dp_08"
                            android:layout_marginBottom="@dimen/dp_12"
                            android:ellipsize="none"
                            android:gravity="center"

                            android:maxLines="1"

                            android:text="Create"


                            android:textColor="@color/base_color"


                            android:textSize="20sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/imageView01" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/qr_scan_area"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_margin="@dimen/dp_06"

                        android:elevation="4dp"

                        android:background="@drawable/shape_qr_scan_button"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/qr_create_area"
                        app:layout_constraintTop_toTopOf="parent">


                        <FrameLayout
                            android:id="@+id/imageView101"
                            android:layout_width="0dp"
                            android:layout_height="0dp"

                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" >

                            <ImageView
                                android:layout_width="@dimen/dp_56"
                                android:layout_height="@dimen/dp_56"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_qr_scan_button_icon_"/>
                        </FrameLayout>




                        <TextView
                            android:id="@+id/textView181"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/dp_08"
                            android:layout_marginBottom="@dimen/dp_12"

                            android:ellipsize="none"
                            android:gravity="center"

                            android:maxLines="1"

                            android:text="Scan"

                            android:textColor="@color/base_color"

                            android:textSize="20sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/imageView101" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.appbar.AppBarLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:elevation="1dp"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:mainViewModel="@{mViewModel}"
                app:viewModel="@{hViewModel}" />




        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/base_medium_color"
            android:padding="@dimen/dp_08"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/item_add_button"
                android:layout_width="@dimen/dp_80"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_button_outline"
                android:gravity="center"
                android:padding="@dimen/dp_02"
                android:text="@string/home_bottom_bt_add"
                android:maxLines="1"
                android:textColor="#B8B8B8"
                android:autoSizeTextType="uniform"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/item_save_button"
                android:layout_width="@dimen/dp_80"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_button_fill"
                android:gravity="center"
                android:padding="@dimen/dp_02"
                android:autoSizeTextType="uniform"
                android:text="@string/home_bottom_bt_done"
                android:maxLines="1"
                android:textColor="@color/base_medium_color"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
